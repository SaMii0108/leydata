# ── Base de datos (Docker Compose + Backend) ───────────────────────────────────
# Estos valores los usa Docker Compose para crear el contenedor de PostgreSQL
# y el backend para conectarse a la base de datos.
# No cambiar los valores por defecto a menos que se necesite un entorno distinto.
DB_USER=admin
DB_PASS=admin
DB_NAME=leydata_db

# ── Keycloak Service Account (Backend) ─────────────────────────────────────────
# Este valor lo genera el script de configuración de Keycloak.
# Después de ejecutar setup-keycloak.sh (o .ps1), copiar el valor impreso aquí.
# Cambia cada vez que se recrea el cliente "leydata-backend" en Keycloak.
KC_BACKEND_SECRET=
