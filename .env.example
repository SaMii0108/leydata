# ── Base de datos (Docker Compose + Backend) ───────────────────────────────────
# Estos valores los usa Docker Compose para crear el contenedor de PostgreSQL
# y el backend para conectarse a la base de datos.
# No cambiar los valores por defecto a menos que se necesite un entorno distinto.
DB_USER=admin
DB_PASS=admin
DB_NAME=leydata_db

# ── Keycloak Service Accounts ───────────────────────────────────────────────────
# Estos valores los genera el script de configuración de Keycloak.
# Después de ejecutar setup-keycloak.sh (o .ps1), copiar los valores impresos aquí.
# Cambian cada vez que se recrean los clientes en Keycloak (docker-compose down -v).
KC_BACKEND_SECRET=
KC_ORCHESTRATOR_CLIENT_SECRET=

# ── Grafana — Observabilidad ────────────────────────────────────────────────────
# Contraseña del panel Grafana (http://localhost:3000). Por defecto: admin
GRAFANA_PASSWORD=admin

# ── WSL2 (solo Windows con WSL2) ───────────────────────────────────────────────
# En WSL2, los contenedores Docker no alcanzan el backend vía host.docker.internal.
# Setear con la IP del adaptador eth0 de WSL: ip addr show eth0 | grep 'inet '
# En Mac/Linux/Windows nativo: dejar vacío o no incluir esta variable.
BACKEND_HOST=

# URL de Loki para el backend (que corre en el host, no en Docker).
# El orquestador usa http://loki:3100 directamente desde docker-compose.yml.
# Solo necesitás setearlo aquí si cambiás el puerto o la dirección de Loki.
LOKI_URL=http://localhost:3100

# Webhook para alertas (Slack, Teams, Discord, o endpoint propio).
# Dejar vacío para deshabilitar. Si está vacío, las alertas se ven en la UI
# de Grafana pero no llegan notificaciones externas.
# Ejemplo Slack:  https://hooks.slack.com/services/T.../B.../...
# Ejemplo Teams:  https://outlook.office.com/webhook/...
GRAFANA_ALERT_WEBHOOK_URL=

# Email(s) destino para alertas — separar múltiples con ";"
# Requiere configurar SMTP abajo (GRAFANA_SMTP_ENABLED=true).
GRAFANA_ALERT_EMAIL_TO=

# SMTP para alertas por email (dejar GRAFANA_SMTP_ENABLED=false si no se usa)
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_FROM_ADDRESS=alertas@leydata.cl
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
