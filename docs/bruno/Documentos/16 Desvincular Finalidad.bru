meta {
  name: Desvincular Finalidad del Documento
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/api/privacy-documents/<uuid-documento>/purposes/<uuid-finalidad>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Elimina el vínculo entre el documento y una finalidad.
  Solo aplica a documentos en estado DRAFT.
  Retorna 204 No Content.
  Requiere rol DPO.
}
