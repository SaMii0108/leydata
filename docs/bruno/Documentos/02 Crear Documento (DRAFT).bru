meta {
  name: Crear Documento (DRAFT)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/privacy-documents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Política de Privacidad — Marketing Digital",
    "category": "MARKETING_DIRECTO",
    "content": "Este documento describe las condiciones bajo las cuales..."
  }
}

docs {
  Crea un documento en estado DRAFT. El documentFamilyId se auto-asigna igual al ID del documento.
  category válidos: POLITICA_PRIVACIDAD, AVISO_COOKIES, DATOS_SENSIBLES, MARKETING_DIRECTO, MENORES_EDAD, TRANSFERENCIA_TERCEROS
  Requiere rol DPO.
}
