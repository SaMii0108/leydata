meta {
  name: Nueva Versión del Documento
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/privacy-documents/<uuid-aqui>/new-version
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Crea un nuevo DRAFT en la misma familia del documento original.
  El document_family_id del nuevo borrador apunta al documento padre.
  Solo aplica a documentos PUBLISHED o ARCHIVED.
  Requiere rol DPO.
}
