meta {
  name: Nueva Versión de Template
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/templates/<uuid-template>/new-version
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Crea una nueva versión DRAFT del template copiando el templateKey.
  El número de version se incrementa automáticamente.
  La versión anterior no se modifica.
  Retorna 201 con el nuevo template en DRAFT.
  Requiere rol DPO o ADMIN.
}
