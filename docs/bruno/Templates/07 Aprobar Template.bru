meta {
  name: Aprobar Template
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/templates/<uuid-template>/approve
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Aprueba un template en estado DRAFT.
  Requiere que el template tenga al menos una purpose con isVisible=true.
  Transición: DRAFT → APPROVED
  Requiere rol DPO o ADMIN.
}
