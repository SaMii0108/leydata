meta {
  name: Version Activa de Familia
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/purposes/active/<uuid-purpose-family>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Obtiene la versión ACTIVE de una familia de finalidades.
  purposeFamilyId: UUID del grupo familiar (= id de la primera versión).
  Solo puede haber una versión ACTIVE por familia en un momento dado.
  Requiere rol DPO o ADMIN.
}
