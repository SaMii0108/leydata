meta {
  name: Listar Finalidades por Dominio
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/purposes/domain/<uuid-dominio>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Lista las finalidades activas de un dominio específico.
  El JEFE_DOMINIO solo puede ver las de sus propios dominios.
  Requiere rol DPO, ADMIN o JEFE_DOMINIO.
}
