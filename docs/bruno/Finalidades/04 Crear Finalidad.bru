meta {
  name: Crear Finalidad
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/purposes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "MARKETING_NEWSLETTER",
    "name": "Envío de ofertas y promociones",
    "description": "Uso del correo electrónico para enviar descuentos y boletines.",
    "shortDescription": "Envío de newsletters",
    "consentStatement": "Al aceptar, autorizo el uso de mi correo para recibir ofertas durante 365 días.",
    "required": false,
    "revocable": true,
    "presentationOrder": 1,
    "legalBasisId": "<uuid-legal-basis>",
    "domainId": "<uuid-dominio>",
    "purposeRequestId": null
  }
}

docs {
  Crea una nueva finalidad de tratamiento de datos.
  code: se normaliza a MAYÚSCULAS y es único en todo el sistema.
  purposeRequestId: opcional pero recomendado para trazabilidad (vincula con la solicitud aprobada).
  consentStatement: texto exacto que leerá el titular. Puede dejarse null y completarse después.
  required: true = el titular no puede rechazarla (ej: facturación).
  revocable: true = el titular puede retirar su consentimiento.
  Requiere rol DPO o ADMIN.
}
