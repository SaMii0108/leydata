meta {
  name: Obtener Finalidad por ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/purposes/<uuid-aqui>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  El JEFE_DOMINIO solo puede ver finalidades de sus propios dominios (403 si no pertenece).
  Requiere rol DPO, ADMIN o JEFE_DOMINIO.
}
