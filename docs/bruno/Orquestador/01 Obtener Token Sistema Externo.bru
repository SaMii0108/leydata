meta {
  name: Obtener Token Sistema Externo
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/empresa-cliente/protocol/openid-connect/token
  body: form-urlencoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: crm-sistema
  username: operador@empresa.cl
  password: operador123
}

docs {
  Obtiene el JWT del sistema externo (realm empresa-cliente en Keycloak local).
  Simula el IdP del cliente B2B que consume los endpoints del Orquestador.
  Prerrequisito: bash scripts/setup-empresa-cliente-realm.sh y EXTERNAL_JWKS_URI en .env.
  Copiar el access_token resultante y guardarlo en la variable secreta externalToken.
}
