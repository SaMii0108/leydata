meta {
  name: Desactivar Categoría
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/data-categories/<uuid-aqui>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Soft delete de la categoría. No la elimina — puede existir en documentos publicados históricos.
  Condiciones: no sistema (isSystem=false) Y sin finalidades activas vinculadas.
  Primero desvincular de todas las finalidades con DELETE /api/purposes/{id}/data-categories/{pdcId}.
  Requiere rol DPO o ADMIN.
}
