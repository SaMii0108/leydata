meta {
  name: Listar Categorías de Datos
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/data-categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Devuelve categorías del sistema (isSystem=true, inmutables) y categorías custom activas.
  isSensitive=true: categorías especiales con protección reforzada (Art. 16 Ley 21.719).
  Requiere rol DPO, ADMIN o JEFE_DOMINIO.
}
