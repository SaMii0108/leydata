meta {
  name: Listar Categorías Sensibles
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/data-categories/sensitive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Filtra solo las categorías sensibles: SALUD, BIOMETRICO, GENETICO,
  VIDA_SEXUAL, RELIGION, POLITICO, SINDICAL, RACIAL.
  Requiere rol DPO, ADMIN o JEFE_DOMINIO.
}
