meta {
  name: Editar Usuario
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/users/<keycloak-id-aqui>
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Nombre Apellido",
    "email": "nuevo@empresa.cl",
    "password": "NuevaPass123!",
    "roleCodes": ["JEFE_DOMINIO"],
    "domainIds": ["<uuid-dominio>"]
  }
}

docs {
  Edita nombre, email, contraseña, roles y dominios del usuario. Todos los campos son opcionales.

  - name: nuevo nombre completo
  - email: nuevo email (debe ser único en el sistema)
  - password: nueva contraseña — Keycloak la marca como temporal (required_action: UPDATE_PASSWORD).
               En el próximo login, Keycloak exige al usuario definir una nueva contraseña.
  - roleCodes: reemplaza los roles actuales. Si se quita JEFE_DOMINIO, sus dominios se limpian.
  - domainIds: reemplaza los dominios asignados. Solo válido con rol JEFE_DOMINIO.

  No aplica a usuarios bloqueados. Requiere rol ADMIN.
  Un ADMIN no puede editar a otro ADMIN.
}
