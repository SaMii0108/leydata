meta {
  name: Listar Bases de Licitud
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/legal-basis
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Catálogo de solo lectura — fundamentos legales de la Ley 21.719.
  consentRequired=true: la finalidad requiere consentimiento explícito del titular.
  consentRequired=false: solo notificación al titular (CONTRATO, OBLIGACION_LEGAL, etc.)
  Requiere rol DPO, ADMIN o JEFE_DOMINIO.
}
