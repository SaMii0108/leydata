meta {
  name: Verificaciones Fallidas
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/audit/integrity/failed?entityType=AGREEMENT
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Lista todas las verificaciones de integridad fallidas (isValid = false) de agreements.
  Sin filtro entityType devuelve fallos de todas las entidades.
  Endpoint movido a /api/audit/integrity/failed (feature/trazabilidad).
  Requiere rol ADMIN.
}
