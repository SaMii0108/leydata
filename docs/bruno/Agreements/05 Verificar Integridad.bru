meta {
  name: Verificar Integridad
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/audit/integrity/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "entityType": "AGREEMENT",
    "entityId": "<uuid-agreement>",
    "checkType": "MANUAL"
  }
}

docs {
  Recalcula el SHA-256 del agreement y lo compara con el hash almacenado.
  Registra el resultado en entity_integrity_log.
  entityType: AGREEMENT | TEMPLATE | DOCUMENT | PURPOSE
  checkType: MANUAL | ON_DEMAND | SCHEDULED
  Endpoint movido a /api/audit/integrity/verify (feature/trazabilidad).
  Requiere rol ADMIN.
}
