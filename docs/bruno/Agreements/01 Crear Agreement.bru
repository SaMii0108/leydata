meta {
  name: Crear Agreement
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/agreements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "dataSubjectId": "<uuid-titular>",
    "templateId": "<uuid-template-activo>",
    "documentId": "<uuid-documento-activo>",
    "purposes": [
      {
        "purposeId": "<uuid-finalidad>",
        "accepted": true
      }
    ],
    "metadata": {
      "captureChannel": "WEB",
      "signatureToken": null,
      "authProvider": "keycloak",
      "extraVariables": null
    }
  }
}

docs {
  Registra un nuevo acuerdo de consentimiento.
  Si ya existe un ACTIVE para el mismo (dataSubjectId, templateId), lo revoca automáticamente (reconsent).
  Genera hash SHA-256 del acuerdo y lo encadena al hash anterior (ledger de integridad).
  Autenticado. Cualquier rol.
}
