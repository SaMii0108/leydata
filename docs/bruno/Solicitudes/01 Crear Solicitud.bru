meta {
  name: Crear Solicitud de Finalidad
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/purpose-requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "domainId": "<uuid-dominio>",
    "title": "Newsletter de ofertas",
    "justification": "Envío de comunicaciones comerciales a clientes suscritos",
    "requestedData": "Email, nombre, historial de compras"
  }
}

docs {
  El JEFE_DOMINIO propone una nueva actividad de tratamiento al DPO.
  Solo puede crear solicitudes para dominios que tiene asignados.
  No puede duplicar solicitudes con el mismo título en PENDING para el mismo dominio.
  Requiere rol JEFE_DOMINIO.
}
