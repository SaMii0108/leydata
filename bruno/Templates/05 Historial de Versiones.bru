meta {
  name: Historial de Versiones (por templateKey)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/templates/family/<templateKey>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Devuelve todas las versiones de un templateKey en orden ascendente de version.
  Reemplazar <templateKey> por el key real, ej: bienvenida-clientes
  Requiere rol DPO o ADMIN.
}
