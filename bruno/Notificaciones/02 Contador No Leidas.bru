meta {
  name: Contador de Notificaciones No Leídas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/notifications/unread-count
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Retorna el número de notificaciones no leídas del usuario autenticado.
  Responde con { "count": <número> }
  Requiere autenticación.
}
