meta {
  name: Obtener Usuario por ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/<uuid-aqui>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Devuelve el detalle de un usuario por su UUID local (BD local, no keycloak_id).
  Los roles se consultan en tiempo real a Keycloak.
  Requiere rol ADMIN.
}
