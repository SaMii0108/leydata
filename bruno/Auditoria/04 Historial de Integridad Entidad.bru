meta {
  name: Historial de Integridad Entidad
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/audit/integrity/log?entityType=AGREEMENT&entityId=<uuid-entidad>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Historial de verificaciones de integridad de una entidad específica, orden descendente.
  entityType: AGREEMENT | TEMPLATE | DOCUMENT | PURPOSE
  entityId: UUID de la entidad a consultar.
  Requiere rol ADMIN.
}
