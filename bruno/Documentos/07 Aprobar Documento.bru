meta {
  name: Aprobar Documento (IN_REVIEW → APPROVED)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/privacy-documents/<uuid-aqui>/approve
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Aprueba el documento. Solo aplica a documentos en IN_REVIEW.
  Requiere rol DPO.
}
