meta {
  name: Descargar PDF del Documento
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/privacy-documents/<uuid-aqui>/pdf
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Descarga el PDF generado del documento.
  Solo aplica a documentos en estado PUBLISHED.
  La respuesta es application/pdf — Bruno la descargará automáticamente.
  Requiere autenticación.
}
