meta {
  name: Verificar Integridad SHA-256
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/privacy-documents/<uuid-aqui>/verify
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Verifica la integridad del documento comparando el hash SHA-256 almacenado
  en AgreementIntegrityLog contra el contenido actual.
  Responde con { "valid": true/false, "storedHash": "...", "currentHash": "..." }
  Requiere autenticación.
}
