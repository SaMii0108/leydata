meta {
  name: Enviar a Revisión (DRAFT → IN_REVIEW)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/privacy-documents/<uuid-aqui>/submit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Cambia el estado de DRAFT a IN_REVIEW.
  Prerequisitos: el documento debe tener content y al menos una finalidad vinculada.
  Requiere rol DPO.
}
