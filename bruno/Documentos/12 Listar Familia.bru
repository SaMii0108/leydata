meta {
  name: Listar Familia de Versiones
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/privacy-documents/family/<family-uuid-aqui>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Lista todas las versiones activas de una familia de documentos.
  El family-uuid es el ID del primer documento publicado de la familia
  (el campo document_family_id de sus sucesores).
  Requiere autenticación.
}
