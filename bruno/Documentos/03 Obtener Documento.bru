meta {
  name: Obtener Documento por ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/privacy-documents/<uuid-aqui>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  DPO/ADMIN: respuesta completa (content, rejectionReason, todos los estados).
  Otros roles: solo documentos PUBLISHED, sin content ni rejectionReason.
}
