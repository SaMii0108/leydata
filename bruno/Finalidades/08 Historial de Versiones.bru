meta {
  name: Historial de Versiones (Familia)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/purposes/family/<uuid-purpose-family>
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Lista todas las versiones de una familia de finalidades, en orden descendente.
  purposeFamilyId: UUID del grupo familiar (= id de la primera versión creada).
  Devuelve versiones con status ACTIVE y SUPERSEDED.
  Requiere rol DPO o ADMIN.
}
