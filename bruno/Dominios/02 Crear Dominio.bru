meta {
  name: Crear Dominio
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/domains
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "mkt",
    "name": "Marketing",
    "description": "Área de marketing digital",
    "jefeId": null
  }
}

docs {
  Crea un área organizacional.
  code: identificador único e inmutable (se usa en logs de auditoría)
  jefeId: UUID del usuario con rol JEFE_DOMINIO (opcional — se puede asignar después)
  Requiere rol ADMIN.
}
