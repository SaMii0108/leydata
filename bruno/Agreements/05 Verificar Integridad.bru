meta {
  name: Verificar Integridad
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/agreements/<uuid-agreement>/verify-integrity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "checkType": "MANUAL"
  }
}

docs {
  Recalcula el SHA-256 del agreement y lo compara con el hash almacenado.
  checkType: MANUAL | SCHEDULED | TRIGGERED (por defecto MANUAL si se omite el body)
  Retorna isValid: true/false y registra el resultado en el ledger de integridad.
  Autenticado. Cualquier rol.
}
