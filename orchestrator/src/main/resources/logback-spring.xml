<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="leydata-orchestrator"/>
    <springProperty name="LOG_LEVEL_ROOT" source="logging.level.root" defaultValue="INFO"/>
    <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <!-- Orquestador corre en Docker → nombre del servicio loki en la red interna. -->
    <springProperty name="LOKI_URL" source="loki.url" defaultValue="http://loki:3100"/>

    <!-- Consola: texto plano para desarrollo. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Archivo JSON: para centralización de logs. Ruta configurable via logging.file.path -->
    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}"}</customFields>
            <includeContext>false</includeContext>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Módulos propios: INFO -->
    <logger name="com.leydata.orchestrator" level="INFO"/>

    <!-- Loki: envía logs estructurados al servidor Loki para exploración en Grafana -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL}/loki/api/v1/push</url>
            <connectionTimeoutMs>1000</connectionTimeoutMs>
            <requestTimeoutMs>5000</requestTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>app=${APP_NAME},level=%level</pattern>
            </label>
            <message>
                <pattern>level=%level app=${APP_NAME} logger=%logger{30} | %msg%ex{short}</pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
        <verbose>false</verbose>
    </appender>

    <!-- Infraestructura: silenciar verbose innecesario -->
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.cloud.gateway" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>
    <logger name="org.springframework.data.redis" level="WARN"/>
    <!-- Silenciar warnings de loki4j cuando Loki no está corriendo -->
    <logger name="com.github.loki4j" level="ERROR"/>

    <root level="${LOG_LEVEL_ROOT}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_JSON"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>
